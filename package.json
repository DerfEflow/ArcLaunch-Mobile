{
  "name": "arclaunch-mobile",
  "version": "1.0.0",
  "description": "ArcLaunch React Native mobile app - offline-first iOS and Android",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:ios": "expo start --ios",
    "start:android": "expo start --android",
    "build": "eas build",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:preview": "eas build --platform all --auto-submit=false",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-secure-store": "~13.0.0",
    "expo-notifications": "~0.28.0",
    "expo-device": "~5.4.0",
    "expo-constants": "~15.4.0",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "@react-native-async-storage/async-storage": "~1.21.0",
    "@react-native-community/netinfo": "~11.0.0",
    "react-native-gesture-handler": "~2.17.0",
    "react-native-screens": "~4.0.0",
    "@react-navigation/native": "~6.1.0",
    "@react-navigation/native-stack": "~6.9.0",
    "@react-navigation/stack": "~6.3.0",
    "@react-navigation/bottom-tabs": "~6.5.0",
    "redux": "~4.2.0",
    "react-redux": "~8.1.0",
    "@reduxjs/toolkit": "~1.9.0",
    "redux-persist": "~6.0.0",
    "axios": "~1.6.0",
    "typescript": "~5.3.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "~12.4.0",
    "@types/react": "~18.2.0",
    "@types/react-native": "~0.72.0",
    "@types/redux-persist": "~4.3.0",
    "jest": "~29.7.0",
    "eslint": "~8.56.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
