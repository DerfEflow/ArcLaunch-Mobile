{
  "name": "arclaunch-mobile",
  "version": "1.0.0",
  "description": "ArcLaunch React Native mobile app - offline-first iOS and Android",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:ios": "expo start --ios",
    "start:android": "expo start --android",
    "build": "eas build",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:preview": "eas build --platform all --auto-submit=false",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "^52.0.0",
    "expo-secure-store": "^13.0.0",
    "expo-notifications": "^0.28.0",
    "expo-device": "^5.4.0",
    "expo-constants": "^16.1.0",
    "react": "^18.3.1",
    "react-native": "0.76.0",
    "react-native-async-storage": "^1.23.0",
    "react-native-community/netinfo": "^11.0.0",
    "react-native-gesture-handler": "^2.18.0",
    "react-native-screens": "^4.1.0",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/stack": "^6.4.8",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "redux": "^5.1.0",
    "react-redux": "^9.2.0",
    "@reduxjs/toolkit": "^2.2.7",
    "redux-persist": "^6.0.0",
    "axios": "^1.7.7",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.6.0",
    "@types/react": "^18.3.3",
    "@types/react-native": "^0.73.0",
    "@types/redux-persist": "^4.3.1",
    "jest": "^29.7.0",
    "jest-preset-expo": "^9.3.0",
    "eslint": "^8.56.0",
    "eslint-config-expo": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
