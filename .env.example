# ArcLaunch Mobile - Environment Variables

# Backend API Configuration
# The base URL for the ArcLaunch backend API
# Required for: authentication, ventures fetching, guide messages, stage confirmations
# Example values: https://arclaunch.net (production), http://localhost:3000 (local dev)
REACT_APP_API_URL=https://arclaunch.net

# API Request Timeout
# Milliseconds to wait for a response before timing out (default: 10000 = 10 seconds)
# Increase if your backend is slow; decrease to fail fast on unreliable networks
REACT_APP_API_TIMEOUT=10000

# Expo Configuration
# Project ID from Expo - obtained via `eas init` or https://expo.dev
# Required for: EAS builds (iOS/Android), push notifications, OTA updates
# Get it: Create project on expo.dev, run `eas init`, or use existing project ID
EXPO_PROJECT_ID=your-expo-project-id

# Environment
# Values: development (local testing), staging (QA), production (release)
# Affects logging verbosity and feature flags
NODE_ENV=development

# Optional: Offline Queue Configuration
# Maximum number of API requests to queue while offline (default: 100)
# Increase for high-activity users, decrease if storage is constrained
# OFFLINE_QUEUE_MAX_SIZE=100

# Optional: Retry Configuration
# Maximum number of retries for failed requests (default: 3)
# Failed requests are dropped after this many attempts
# MAX_RETRIES=3

# Optional: Exponential Backoff Configuration
# Initial retry delay in milliseconds (default: 1000 = 1 second)
# Each retry waits 2x longer (1s, 2s, 4s, ...)
# RETRY_INITIAL_DELAY_MS=1000

# Optional: Push Notifications
# No explicit configuration needed here - the app automatically registers
# the device for push notifications on startup via Expo Notifications API
